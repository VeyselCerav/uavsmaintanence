# Render (backend) ortam değişkenleri — pano üzerinden girilir; dosyayı commit ETMEYİN.

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=uzun-rastgele-bir-deger-uretin
DJANGO_ALLOWED_HOSTS=uavs-backend.onrender.com
DJANGO_ADMIN_ENABLED=false

# Neon PostgreSQL connection string (Settings → Connection string → pooled)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Vercel frontend adresi (https ile, sondaki / olmadan)
CORS_ALLOWED_ORIGINS=https://uavsmaintanence.vercel.app
CSRF_TRUSTED_ORIGINS=https://uavsmaintanence.vercel.app

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# İlk deploy sonrası false yapın (demo seed tekrar çalışmasın)
SEED_DEMO=true
